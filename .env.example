# Model API key (optional — the app runs offline without it)
MODEL_API_KEY=
# Small/cheap model for interrogation Q&A (short prompts need no frontier reasoning)
META_MODEL_INTERROGATE=muse-spark-1.3-contributor
META_API_BASE=https://api.meta.ai/v1
# Self-hosted / local dev only: allow BYOK endpoints on LAN/loopback or plain
# HTTP (e.g. local Ollama). NEVER enable on a public deployment — the server
# would fetch internal addresses with user keys attached.
# ALLOW_PRIVATE_ENDPOINTS=1
