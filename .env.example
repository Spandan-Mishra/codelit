# Model API key (optional locally — the app runs offline without it;
# production should set it so defense grading uses the live Meta model)
MODEL_API_KEY=
# Small/cheap model for interrogation Q&A (short prompts need no frontier reasoning)
META_MODEL_INTERROGATE=muse-spark-1.3-contributor
META_API_BASE=https://api.meta.ai/v1
# Signs native-agent browser sessions. Set once per deployment and keep it
# stable — changing it signs everyone out (devices stay paired, attempts
# keep their owner). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NATIVE_SESSION_SECRET=
# Optional dedicated secret for the signed anonymous browser identity used
# by legacy duel/agent-run flows. Falls back to NATIVE_SESSION_SECRET.
# CODELIT_ANON_SECRET=
# Set only when a trusted reverse proxy (Caddy/Cloudflare) is the sole
# ingress and overwrites forwarding headers itself. Never enable on a
# directly exposed app port: clients could spoof X-Forwarded-For.
# CODELIT_TRUST_PROXY_HEADERS=1
