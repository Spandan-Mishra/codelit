[Unit]
Description=Codelit (Next.js + bubblewrap code runner)
After=network.target

[Service]
Type=simple
User=codelit
WorkingDirectory=/opt/codelit
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=on-failure
RestartSec=3
# The runner spawns bubblewrap children; do not add PrivateUsers=,
# ProtectSystem=strict, or NoNewPrivileges=true here — unprivileged user
# namespaces are the isolation mechanism and those directives break it.
ReadWritePaths=/opt/codelit/data /opt/codelit/.codelit-runtime

[Install]
WantedBy=multi-user.target
